{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sesimbra-rental-push",
  "main": "src/index.js",
  "compatibility_date": "2026-10-05",
  "observability": { "enabled": true },
  "kv_namespaces": [
    {
      "binding": "PUSH_STATE",
      "id": "REPLACE_WITH_CLOUDFLARE_KV_NAMESPACE_ID"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://samback.github.io",
    "VAPID_SUBJECT": "https://samback.github.io/sesimbra-rental-monitor/"
  }
}
